# Storefront API base. The admin app talks to /api/v1; the storefront talks to
# /shop/v1 on the same FastAPI instance.
NEXT_PUBLIC_SHOP_API_URL=http://localhost:8000/shop/v1
NEXT_PUBLIC_USE_LIVE_CATALOG=true

# Where product media is served from in local dev.
NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:8000/uploads

# While /shop/v1 does not exist yet, every data read is served from
# src/mocks/fixtures.ts instead of the network. Flip to "false" once the
# backend is live — see src/mocks/README.md for the removal checklist.
NEXT_PUBLIC_USE_FIXTURES=true
