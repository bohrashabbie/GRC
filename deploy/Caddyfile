# www resolves to the same host, so it needs a site block of its own or Caddy
# answers 404 for it. Redirect rather than serve both: one canonical origin
# keeps sessions, canonical URLs and the sitemap consistent.
www.{$STORE_DOMAIN} {
    redir https://{$STORE_DOMAIN}{uri} permanent
}

{$STORE_DOMAIN} {
    encode zstd gzip

    handle /shop/v1/* {
        reverse_proxy api:8000
    }

    handle /uploads/* {
        reverse_proxy api:8000
    }

    handle {
        reverse_proxy storefront:3100
    }
}

{$ADMIN_DOMAIN} {
    encode zstd gzip

    handle /api/v1/* {
        reverse_proxy api:8000
    }

    handle /uploads/* {
        reverse_proxy api:8000
    }

    handle {
        reverse_proxy admin:3000
    }
}
