# Copy to .env.vps and replace every value before deployment.
STORE_DOMAIN=shop.example.com
ADMIN_DOMAIN=admin.example.com

# Only for the temporary IP-access overlay (compose.ip.yml), used before DNS is
# mapped. Set it to the VPS public IPv4 address. Leave it unset for normal
# HTTPS deployments; STORE_DOMAIN and ADMIN_DOMAIN are still required either way.
#PUBLIC_HOST=203.0.113.10

POSTGRES_DB=grc
POSTGRES_USER=grc
# Use a long URL-safe value (letters, numbers, - and _) because it is embedded
# in DATABASE_URL by Docker Compose.
POSTGRES_PASSWORD=replace_with_a_long_url_safe_password

# Generate with: openssl rand -hex 64
JWT_SECRET_KEY=replace_with_at_least_64_random_hex_characters

OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=replace_with_a_unique_strong_owner_password

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
